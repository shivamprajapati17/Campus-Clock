# ─────────────────────────────────────────────────────────────
# Campus Clock — environment template
# Copy to `.env.local` and fill in your own Supabase project values.
# The app ships with a built-in mock-data fallback, so it also runs
# without these set.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
