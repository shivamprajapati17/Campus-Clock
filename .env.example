# Supabase (optional — the app falls back to seeded data without it)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: lets the Sprout assistant answer with an LLM.
# Server-side only — never prefix these with NEXT_PUBLIC_.
# NVIDIA NIM is used first (OpenAI-compatible endpoint).
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Anthropic is the alternative provider when no NVIDIA key is present.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
